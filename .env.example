DATABASE_URL="postgresql://notary_app:changeme@localhost:5432/notary_financial_control?schema=public"
SESSION_SECRET="changeme-generate-a-random-secret-for-your-office-deployment"

# Leave "false" until the `caddy` service's TLS (docker-compose.yml,
# Caddyfile) is confirmed reachable from a staff machine — see
# docs/DEPLOYMENT.md "TLS for LAN Access". Flipping to "true" before then
# drops the session cookie on plain-HTTP requests and locks staff out.
COOKIE_SECURE="false"
