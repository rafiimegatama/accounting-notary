// ================================================================
// Prisma schema — mirrors ddl_notary_financial_control.sql exactly.
// CHECK constraints and triggers (immutability, no-delete, updated_at)
// are NOT expressible in Prisma schema — they live in the DDL and are
// applied via the initial migration's raw SQL (see prisma/migrations
// README). Valid string values for "enum-like" fields are documented
// per field here; the authoritative constraint is the DB CHECK in the DDL.
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  clientType     String?  @map("client_type") // INDIVIDUAL | COMPANY
  contactPhone   String?  @map("contact_phone")
  contactEmail   String?  @map("contact_email")
  contactAddress String?  @map("contact_address")
  identityNumber String?  @map("identity_number")
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE
  notes          String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  matters      Matter[]
  transactions FinancialTransaction[]
  attachments  FinancialAttachment[]

  @@map("client")
}

model Matter {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  matterName        String   @map("matter_name")
  matterType        String?  @map("matter_type")
  service           String?
  status            String   @default("ACTIVE") // ACTIVE | CLOSED | CANCELLED
  responsibleStaff  String?  @map("responsible_staff")
  notes             String?
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  client       Client                  @relation(fields: [clientId], references: [id])
  invoices     Invoice[]
  costDetails  CostDetail[]
  transactions FinancialTransaction[]
  attachments  FinancialAttachment[]

  @@index([clientId, status])
  @@map("matter")
}

model Invoice {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matterId             String   @map("matter_id") @db.Uuid
  invoiceNumber        String   @unique @map("invoice_number")
  invoiceDate          DateTime @map("invoice_date") @db.Date
  dueDate              DateTime? @map("due_date") @db.Date
  totalAmount          Decimal  @map("total_amount") @db.Decimal(18, 2)
  allowPartialPayment  Boolean  @default(true) @map("allow_partial_payment")
  status               String   @default("ISSUED") // DRAFT | ISSUED | VOID
  notes                String?
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @map("updated_at")

  matter       Matter               @relation(fields: [matterId], references: [id])
  costDetails  CostDetail[]
  allocations  PaymentAllocation[]
  attachments  FinancialAttachment[]

  @@index([matterId, status])
  @@map("invoice")
}

model CostDetail {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matterId        String   @map("matter_id") @db.Uuid
  invoiceId       String?  @map("invoice_id") @db.Uuid
  costDate        DateTime @map("cost_date") @db.Date
  description     String
  category        String?
  amount          Decimal  @db.Decimal(18, 2)
  sourceType      String   @default("MANUAL") @map("source_type")
  sourceReference String?  @map("source_reference")
  status          String   @default("ACTIVE") // ACTIVE | VOID
  notes           String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  matter      Matter                @relation(fields: [matterId], references: [id])
  // Restrict, not the Prisma-default SetNull for an optional relation: an
  // invoice must not silently detach from a cost detail that references
  // it — matches ddl_notary_financial_control.sql's documented intent
  // (previously undeclared here, so migrations actually applied SetNull;
  // see prisma/migrations/20260814180000_fix_ondelete_restrict).
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  attachments FinancialAttachment[]

  @@index([matterId, status])
  @@index([invoiceId])
  @@map("cost_detail")
}

model FinancialTransaction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionDate   DateTime @map("transaction_date") @db.Date
  amount            Decimal  @db.Decimal(18, 2)
  direction         String   // IN | OUT
  description       String
  financialType     String   @default("UNCLASSIFIED") @map("financial_type") // UNCLASSIFIED | PAYMENT | DEPOSIT | DISBURSEMENT | OTHER
  clientId          String?  @map("client_id") @db.Uuid
  matterId          String?  @map("matter_id") @db.Uuid
  sourceType        String   @default("SOURCE_PENDING") @map("source_type")
  sourceReference   String?  @map("source_reference")
  reviewStatus      String   @default("NORMAL") @map("review_status") // NORMAL | WARNING | REVIEW_REQUIRED
  status            String   @default("ACTIVE") // ACTIVE | VOIDED
  voidedAt          DateTime? @map("voided_at")
  voidedBy          String?  @map("voided_by")
  voidReason        String?  @map("void_reason")
  notes             String?
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  // Restrict — see cost_detail.invoice comment above for why (same
  // undeclared-onDelete drift, same fix, same migration).
  client      Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter      Matter?               @relation(fields: [matterId], references: [id], onDelete: Restrict)
  payment     Payment?
  deposit     Deposit?
  disbursement Disbursement?
  attachments FinancialAttachment[]

  @@index([matterId, status])
  @@index([clientId, status])
  @@index([transactionDate])
  @@map("financial_transaction")
}

model Payment {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialTransactionId String   @unique @map("financial_transaction_id") @db.Uuid
  notes                  String?
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")

  transaction FinancialTransaction @relation(fields: [financialTransactionId], references: [id])
  allocations PaymentAllocation[]

  @@map("payment")
}

model Deposit {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialTransactionId String   @unique @map("financial_transaction_id") @db.Uuid
  notes                  String?
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")

  transaction FinancialTransaction @relation(fields: [financialTransactionId], references: [id])

  @@map("deposit")
}

model Disbursement {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialTransactionId String   @unique @map("financial_transaction_id") @db.Uuid
  category               String?
  bankAccountId          String?  @map("bank_account_id") @db.Uuid
  notes                  String?
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")

  transaction FinancialTransaction @relation(fields: [financialTransactionId], references: [id])
  bankAccount BankAccount?         @relation(fields: [bankAccountId], references: [id])

  @@map("disbursement")
}

// Structured per-bank disbursement categorization (Roadmap #3). Records which
// funding bank/account paid out a Disbursement, additive to (not a replacement
// for) the existing free-text `category` (what the money was spent on). No
// prevent_delete() trigger — same convention as Client/Matter; protection
// against removing a referenced account comes from the FK (ON DELETE RESTRICT
// in the DDL, see ddl_notary_financial_control.sql) instead.
model BankAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankName      String   @map("bank_name")
  accountName   String?  @map("account_name")
  accountNumber String?  @map("account_number")
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  notes         String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  disbursements Disbursement[]

  @@map("bank_account")
}

model PaymentAllocation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  invoiceId       String?   @map("invoice_id") @db.Uuid
  allocationType  String    @map("allocation_type") // INVOICE_PAYMENT | DEPOSIT_TOPUP | OTHER
  amount          Decimal   @db.Decimal(18, 2)
  status          String    @default("ACTIVE") // ACTIVE | REVERSED
  reversedAt      DateTime? @map("reversed_at")
  reversedBy      String?   @map("reversed_by")
  reversalReason  String?   @map("reversal_reason")
  notes           String?
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment  @relation(fields: [paymentId], references: [id])
  // Restrict — same fix as cost_detail.invoice above.
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@index([paymentId, status])
  @@map("payment_allocation")
}

model FinancialAttachment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filePath      String   @map("file_path")
  fileName      String   @map("file_name")
  fileType      String?  @map("file_type")
  clientId      String?  @map("client_id") @db.Uuid
  matterId      String?  @map("matter_id") @db.Uuid
  transactionId String?  @map("transaction_id") @db.Uuid
  costDetailId  String?  @map("cost_detail_id") @db.Uuid
  invoiceId     String?  @map("invoice_id") @db.Uuid
  uploadedBy    String   @map("uploaded_by")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  // Restrict on all five — same fix as cost_detail.invoice above: an
  // attachment must not silently detach from the record it documents.
  client      Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter      Matter?               @relation(fields: [matterId], references: [id], onDelete: Restrict)
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  costDetail  CostDetail?           @relation(fields: [costDetailId], references: [id], onDelete: Restrict)
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // idx_attach_transaction/matter/client/cost_detail/invoice all exist in
  // the database (prisma/migrations/20260810150100_constraints_and_triggers,
  // matching ddl_notary_financial_control.sql) as PARTIAL indexes
  // (`WHERE x_id IS NOT NULL`). Deliberately not declared as `@@index`
  // here: Prisma's schema DSL has no partial/filtered-index syntax as of
  // this project's pinned version (5.20), so a plain `@@index([transactionId])`
  // would describe a *different*, non-partial index than what's actually
  // in the database — `prisma migrate dev` run against that mismatch could
  // try to drop the smaller partial index and create a larger full one.
  // Leaving this undeclared-but-documented is the accurate state, not an
  // oversight.
  @@map("financial_attachment")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  action        String
  userId        String   @map("user_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  reason        String?

  @@index([entityType, entityId, occurredAt])
  @@map("audit_log")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedBy String   @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("system_setting")
}

// Minimal local auth (Section 23 of one-shot build prompt). Not a
// permission/role system — every staff account can do everything, matching
// the office's actual size and the non-goal of building complex approval
// workflow. PIN, not password, since this is a shared office terminal.
model Staff {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  pinHash    String   @map("pin_hash")
  pinSalt    String   @map("pin_salt")
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("staff")
}
